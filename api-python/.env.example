# Copia este archivo como .env y pon los datos de tu proyecto de Supabase
# (Supabase > botón Connect > "Session pooler" > View parameters).
# La API sólo conoce estos datos: para usar otra BD cambia este archivo, no el código.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.tu-ref-de-proyecto
DB_PASSWORD=tu-contraseña-de-la-base-de-datos
DB_NAME=postgres
DB_SSLMODE=require

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria
